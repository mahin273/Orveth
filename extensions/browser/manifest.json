{
  "manifest_version": 3,
  "name": "Orveth Download Manager",
  "version": "0.2.4",
  "description": "Send downloads and media streams directly to Orveth Accelerated Download Manager.",
  "permissions": [
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Orveth Download Manager"
  }
}
