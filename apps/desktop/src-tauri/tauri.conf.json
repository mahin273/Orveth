{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orveth",
  "version": "0.2.5",
  "identifier": "com.orveth.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orveth",
        "width": 1050,
        "height": 700,
        "minWidth": 800,
        "minHeight": 550,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "High-performance modular download manager",
    "longDescription": "A modern, power-user download manager built with Rust and React. Engineered for extreme transfer speeds, network resilience, and local-first privacy.",
    "copyright": "2026 Mahin Khan",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ],
        "files": {
          "/usr/share/metainfo/com.orveth.desktop.metainfo.xml": "metainfo/com.orveth.desktop.metainfo.xml"
        }
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator3"
        ],
        "files": {
          "/usr/share/metainfo/com.orveth.desktop.metainfo.xml": "metainfo/com.orveth.desktop.metainfo.xml"
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
